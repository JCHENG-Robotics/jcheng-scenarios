{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/scen/evaluation-specification.v1.schema.json",
  "title": "SCEN evaluation specification v1",
  "description": "Declared metrics and test protocol. Thresholds are absent until data collection justifies them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "provenance",
    "metrics",
    "test_protocol",
    "reporting"
  ],
  "properties": {
    "schema_version": {
      "const": "jcheng.scenario.evaluation.v1"
    },
    "id": {
      "$ref": "#/$defs/profile_id"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "test_protocol": {
      "$ref": "#/$defs/protocol"
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "note"],
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created", "updated", "source_kind", "sources"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "source_kind": {
          "enum": ["design", "literature", "synthetic", "recorded", "hardware"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "internal_design",
            "public_dataset",
            "paper",
            "repository",
            "operator_input"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "verification": {
      "enum": ["Verified", "Partially verified", "Unverified", "Inconclusive"]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition",
        "unit",
        "direction",
        "threshold",
        "threshold_status",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "unit": {
          "enum": ["ratio", "percent", "s", "m", "count"]
        },
        "direction": {
          "enum": ["higher_is_better", "lower_is_better", "target"]
        },
        "threshold": {
          "type": ["number", "null"]
        },
        "threshold_status": {
          "enum": ["not_set", "proposed", "fixed"]
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "threshold_status": {
                "const": "not_set"
              }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "threshold_status": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "data_sources", "rules"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["L0", "L1", "L2", "L3", "L4", "L5"]
          }
        },
        "data_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "synthetic",
              "public",
              "recorded",
              "mock",
              "simulation",
              "hardware"
            ]
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
