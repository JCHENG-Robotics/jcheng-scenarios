{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/scen/task-specification.v1.schema.json",
  "title": "SCEN task specification v1",
  "description": "Declarative goal, preconditions, completion and failure conditions. It is not an execution plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "provenance",
    "goal",
    "preconditions",
    "success_conditions",
    "failure_conditions",
    "constraints",
    "out_of_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "jcheng.scenario.task.v1"
    },
    "id": {
      "$ref": "#/$defs/profile_id"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "goal": {
      "$ref": "#/$defs/goal"
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "success_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "failure_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/condition"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "out_of_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created", "updated", "source_kind", "sources"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "source_kind": {
          "enum": ["design", "literature", "synthetic", "recorded", "hardware"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "internal_design",
            "public_dataset",
            "paper",
            "repository",
            "operator_input"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "verification": {
      "enum": ["Verified", "Partially verified", "Unverified", "Inconclusive"]
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "target_class", "destination"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "target_class": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "destination": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "predicate", "measurable", "verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "predicate": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 400
        },
        "measurable": {
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    }
  }
}
