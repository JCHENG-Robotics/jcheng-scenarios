{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/scen/scenario-registry.v1.schema.json",
  "title": "SCEN scenario registry v1",
  "description": "Repository-local registry of declarative scenarios. It is not a jcheng-interfaces contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "updated", "scenarios"],
  "properties": {
    "schema_version": {
      "const": "jcheng.scenario.registry.v1"
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path",
        "profile",
        "domain",
        "delivery",
        "verification",
        "summary",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^scenarios/[a-z][a-z0-9_]*$"
        },
        "profile": {
          "const": "scenario.yaml"
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "delivery": {
          "enum": ["Complete", "In progress", "Planned", "Not started"]
        },
        "verification": {
          "enum": ["Verified", "Partially verified", "Unverified", "Inconclusive"]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          }
        }
      }
    }
  }
}
