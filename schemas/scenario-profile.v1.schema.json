{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/scen/scenario-profile.v1.schema.json",
  "title": "SCEN scenario profile v1",
  "description": "Top-level declarative scenario document. Sub-profiles are separate files validated by their own schemas.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "domain",
    "summary",
    "delivery",
    "verification",
    "provenance",
    "profiles",
    "consumers",
    "boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "jcheng.scenario.profile.v1"
    },
    "id": {
      "$ref": "#/$defs/scenario_id"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "semantics",
        "task",
        "capability_requirements",
        "operational_constraints",
        "evaluation"
      ],
      "properties": {
        "environment": {
          "$ref": "#/$defs/profile_path"
        },
        "semantics": {
          "$ref": "#/$defs/profile_path"
        },
        "task": {
          "$ref": "#/$defs/profile_path"
        },
        "capability_requirements": {
          "$ref": "#/$defs/profile_path"
        },
        "operational_constraints": {
          "$ref": "#/$defs/profile_path"
        },
        "evaluation": {
          "$ref": "#/$defs/profile_path"
        }
      }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consumer"
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    }
  },
  "$defs": {
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "delivery": {
      "enum": ["Complete", "In progress", "Planned", "Not started"]
    },
    "verification": {
      "enum": ["Verified", "Partially verified", "Unverified", "Inconclusive"]
    },
    "profile_path": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.yaml$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created", "updated", "source_kind", "sources"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "source_kind": {
          "enum": ["design", "literature", "synthetic", "recorded", "hardware"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "internal_design",
            "public_dataset",
            "paper",
            "repository",
            "operator_input"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "role", "integration"],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "integration": {
          "$ref": "#/$defs/delivery"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  }
}
