{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/scen/operational-constraints.v1.schema.json",
  "title": "SCEN operational constraints v1",
  "description": "Business, environmental and risk constraints. They never replace the system layer's runtime safety mechanism.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "provenance",
    "business",
    "environment",
    "risks",
    "safety_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "jcheng.scenario.operational_constraints.v1"
    },
    "id": {
      "$ref": "#/$defs/profile_id"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "business": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "environment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "owner"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created", "updated", "source_kind", "sources"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "source_kind": {
          "enum": ["design", "literature", "synthetic", "recorded", "hardware"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "internal_design",
            "public_dataset",
            "paper",
            "repository",
            "operator_input"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "verification": {
      "enum": ["Verified", "Partially verified", "Unverified", "Inconclusive"]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "description", "mitigation"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "severity": {
          "enum": ["low", "medium", "high"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "mitigation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  }
}
