{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcheng-robotics.github.io/schemas/scen/capability-requirements.v1.schema.json",
  "title": "SCEN capability requirements v1",
  "description": "Abstract device, algorithm and interface capabilities a scenario requires. Requirements are not device claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "provenance",
    "matching_status",
    "vocabulary_status",
    "device_requirements",
    "algorithm_requirements",
    "interface_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "jcheng.scenario.capability_requirements.v1"
    },
    "id": {
      "$ref": "#/$defs/profile_id"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "matching_status": {
      "enum": ["Complete", "In progress", "Planned", "Not started"]
    },
    "vocabulary_status": {
      "enum": ["local_draft", "proposed", "contracted"]
    },
    "device_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/device_requirement"
      }
    },
    "algorithm_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/algorithm_requirement"
      }
    },
    "interface_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/interface"
      }
    }
  },
  "$defs": {
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "maxLength": 120
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "created", "updated", "source_kind", "sources"],
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "created": {
          "$ref": "#/$defs/date"
        },
        "updated": {
          "$ref": "#/$defs/date"
        },
        "source_kind": {
          "enum": ["design", "literature", "synthetic", "recorded", "hardware"]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {
          "enum": [
            "internal_design",
            "public_dataset",
            "paper",
            "repository",
            "operator_input"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "verification": {
      "enum": ["Verified", "Partially verified", "Unverified", "Inconclusive"]
    },
    "basis": {
      "enum": ["design_target", "measured", "derived", "assumed"]
    },
    "role": {
      "enum": ["arm", "gripper", "camera", "base", "sensor", "teleop"]
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "value", "unit"],
      "properties": {
        "op": {
          "enum": [">=", "<=", ">", "<", "==", "!="]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "device_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "role",
        "interface",
        "requirement",
        "basis",
        "rationale",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 120
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "interface": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$",
          "maxLength": 120,
          "description": "Concrete device capability that must be declared by the device filling this role."
        },
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "algorithm_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability",
        "requirement",
        "basis",
        "rationale",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "capability": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 120
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "requirement", "note"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    }
  }
}
